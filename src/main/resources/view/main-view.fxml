<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.evaluacion_javafx_citastecnicas.controller.MainController">
    <top>
        <Label text="TecnoAsistencia Nicaragua S.A. - Gestión de citas técnicas" styleClass="titulo">
            <padding>
                <Insets top="12.0" right="16.0" bottom="8.0" left="16.0"/>
            </padding>
        </Label>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab fx:id="tabClientes" text="Clientes"/>
                <Tab fx:id="tabCitas" text="Citas técnicas"/>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
